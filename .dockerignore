# What never goes into the image — and the first entry is the one that matters.
#
# android/ holds lenta-release.pem, the key the Android app is signed with. A build context is a copy
# of this folder sent to the Docker daemon, and anything in it can end up in a layer of a published
# image, which is a public thing. The key is excluded here, the same way it is excluded from every
# release tarball, and a test checks that this line is still here.
android/
*.pem
*.key
*.keystore
*.jks
*.cred
.env

# Build tools for the older-TV bundle. The bundle itself (web/legacy/) is committed and IS wanted.
tools/node_modules/
tools/.fills.js

.git/
.github/
.github-base
.gitignore
.dockerignore
CLAUDE.md

__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Local data and packages
*.db
*.db-wal
*.db-shm
dev-data/
server/dev-data/
out/
*.tar.gz
*.zip

# Nothing in the image runs the tests
tests/

.vscode/
.idea/
.DS_Store
Thumbs.db
