 ],
 "$defs": {
  "scope": {
   "enum": [
    "watch",
    "titles",
    "library",
    "admin"
   ]
  },
  "action": {
   "enum": [
    "pause",
    "play",
    "seek",
    "stop",
    "open",
    "subtitles",
    "audio",
    "next",
    "previous",
    "skip_intro",
    "volume",
    "mute",
    "minimize",
    "expand",
    "quality"
   ]
  },
  "device": {
   "type": "object",
   "properties": {
    "device_id": {
     "type": "string"
    },
    "kind": {
     "enum": [
      "pc",
      "android",
      "tv"
     ]
    },
    "name": {
     "type": "string"
    },
    "item_id": {
     "type": [
      "integer",
      "null"
     ]
    },
    "channel_id": {
     "type": [
      "integer",
      "null"
     ]
    },
    "state": {
     "enum": [
      "playing",
      "paused",
      "buffering",
      "idle"
     ]
    },
    "position_s": {
     "type": "number"
    },
    "duration_s": {
     "type": "number"
    },
    "seen_s": {
     "type": "number"
    },
    "last_command": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "properties": {
        "id": {
         "type": "string"
        },
        "action": {
         "$ref": "#/$defs/action"
        },
        "status": {
         "enum": [
          "queued",
          "sent",
          "running",
          "done",
          "failed",
          "expired"
         ]
        },
        "position_s": {
         "type": [
          "number",
          "null"
         ]
        },
        "reason": {
         "enum": [
          null,
          "timeout"
         ]
        }
       },
       "required": [
        "id",
        "action",
        "status",
        "reason",
        "position_s"
       ],
       "additionalProperties": false
      }
     ]
    },
    "audio": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "string",
       "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})?$"
      }
     ]
    },
    "audio_options": {
     "type": "array",
     "items": {
      "type": "string",
